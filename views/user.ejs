<!DOCTYPE html>
<html>
<head>
  <title>Applicants</title>
</head>
<body>
  <h2>All Applicants</h2>
  <ul>
    <% users.forEach(user => { %>
      <li>
        <strong><%= user.name %></strong> - <%= user.Jobrole %> |
        <a href="/resume/<%= user._id %>" target="_blank">View Resume</a>
      </li>
    <% }) %>
  </ul>
</body>
</html>
